# Generate a unique local token; never commit a real value.
AETHER_LOCAL_TOKEN=replace-with-a-random-token-of-at-least-32-characters

# Exact comma-separated browser origins allowed to call the local API.
ALLOWED_ORIGINS=https://aether-secure.pages.dev,http://localhost:5173,http://127.0.0.1:5173

# The server binds to 127.0.0.1:3000 by default.
PORT=3000

# Optional: absolute path to Chromium in Termux or another local environment.
# CHROMIUM_PATH=/data/data/com.termux/files/usr/bin/chromium-browser
