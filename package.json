{
  "name": "aether-agent",
  "version": "2.0.0",
  "private": true,
  "description": "Aether v2: agente BYOK com Cloudflare Worker, frontend web e aplicativo Android nativo.",
  "engines": {
    "node": ">=20.19.0"
  },
  "scripts": {
    "dev": "node ./node_modules/vite/bin/vite.js --host 127.0.0.1 --config frontend/vite.config.js",
    "build": "node ./node_modules/vite/bin/vite.js build --config frontend/vite.config.js",
    "test:cloud": "node --test cloud/*.test.mjs",
    "test:frontend": "node --test frontend/tests/*.test.js",
    "test": "node --test tests/*.test.mjs cloud/*.test.mjs frontend/tests/*.test.js",
    "test:browser": "node tests/browser.mjs",
    "deploy:pages": "wrangler pages deploy frontend/dist --project-name aether-secure --branch main",
    "deploy:worker": "wrangler deploy --config cloud/wrangler.toml",
    "setup": "node scripts/setup.mjs",
    "start": "node --env-file=backend/.env backend/server.js",
    "instructions": "node scripts/instructions.mjs",
    "test:backend": "node --test tests/*.test.mjs"
  },
  "license": "SEE LICENSE",
  "workspaces": [
    "backend",
    "frontend"
  ]
}
